      "W4": ["algorithm"],
      "W5": ["algorithm"],
      "W6": ["algorithm"]
    }
  },
  "review_policy": {
    "enabled": true,
    "review_prefix": "R",
    "require_accepted_review": true,
    "repair_on_amend": true
  },
